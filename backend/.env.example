NODE_ENV=production
# Usar el pooler de Supabase en modo transacción (puerto 6543), no la conexión
# directa (5432): en serverless cada instancia abre conexiones propias.
DATABASE_URL=postgresql://postgres.[PROJECT]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
JWT_SECRET=cambia_esto_por_un_secreto_largo
JWT_EXPIRES_IN=7d
CORS_ORIGIN=https://tu-frontend.vercel.app
# false en producción: con true cada cold start introspecciona todo el esquema
# (y puede alterar tablas). Activarlo solo puntualmente para aplicar cambios.
DB_SYNCHRONIZE=false
